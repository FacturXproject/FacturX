# PostgreSQL (POSTGRES_DB must stay "facturx": the backend datasource uses this name)
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=facturx

# Mailpit SMTP (local mail catcher, UI on https://localhost:8443/mailpit/)
MAIL_HOST=mailpit
MAIL_PORT=1025

# Application mail
MAIL_FROM=noreply@facturx.local

# Public application URL
APP_BASE_URL=https://localhost:8443
